# Live scratch: rows accumulate across runs, and a run's server log explains them
# only until the next one. Snapshots go to docs/data/ when a feature ships.
results/

# MLX and MTPLX each run from their own venv; the pins are committed, the wheels are not.
runtimes/mlx/.venv/

# Working state inside a task box, not history.
HANDOFF.md

# Generated, and local: committed it would point every session anybody opens here at a
# 27B model on loopback, and hook every one of them.
.claude/settings.local.json

# scripts/ladder.sh and scripts/screen.sh import deskverdict.py, so any real run writes
# bytecode beside it.
__pycache__/
