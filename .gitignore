results/*.jsonl

# MLX runs from its own venv; the pins are committed, the wheels are not.
mlx/.venv/

# The session handoff. Working state inside a task box, not history: what survives a
# feature is its commits and its boxes, and a reviewer should read those rather than a
# diary of how the work went.
HANDOFF.md

# Generated by scripts/claude-code-settings.sh, and local for the reason that script
# gives — committed, it would point every session anybody opens on this repository at a
# 27B model on loopback, and hook every one of them.
.claude/settings.local.json
