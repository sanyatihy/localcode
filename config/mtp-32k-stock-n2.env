# config/mtp-32k-stock.env at draft depth 2. Every MTP config fixed 3 and the depth was
# never varied, while the ratio decayed 1.57x to 1.26x with prompt depth; 0051 sweeps it at
# the depth where that decay was measured. Everything else is unchanged, so the arms differ
# by the depth alone.
MODEL_HF="bartowski/Qwen3.8-27B-GGUF:Q4_K_M"
HOST="127.0.0.1"
PORT="8081"
CTX_SIZE="32768"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
FLASH_ATTN="auto"
N_GPU_LAYERS="999"
PARALLEL="1"
JINJA="1"
SPEC_TYPE="draft-mtp"
SPEC_DRAFT_N_MAX="2"
