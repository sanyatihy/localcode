# The third candidate, and the cheapest: config/tuned.env unchanged, plus the MTP head the
# target GGUF already carries. Stock llama.cpp reports those tensors as unused and throws
# them away; PR #27342's build makes an MTP draft context against the same weights, so unlike
# a drafter this costs no second model.
SERVER_BIN="$HOME/.local/src/llama.cpp-dflash2/build/bin/llama-server"
MODEL_HF="bartowski/Qwen3.8-27B-GGUF:Q4_K_M"
HOST="127.0.0.1"
PORT="8081"
CTX_SIZE="32768"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
FLASH_ATTN="auto"
N_GPU_LAYERS="999"
PARALLEL="1"
JINJA="1"
SPEC_TYPE="draft-mtp"
SPEC_DRAFT_N_MAX="3"
