# The dedicated node's serving config (0056): config/agent.env with the multimodal
# projector off. The node has 36 GB against the laptop's 32 and no desk to protect, so it
# starts from the context the laptop settled rather than below it.
#
# The levers still unsettled here are the screen's: CACHE_RAM, UBATCH_SIZE, the KV type,
# MLOCK, and how far above 49,152 the context goes before the ladder's pass rule fails.
# This file records what the screen settles.
#
# HOST stays loopback like every committed config. The serving LaunchDaemon sets
# HOST=0.0.0.0 in its environment, per 0053.
MODEL_HF="bartowski/Qwen3.8-27B-GGUF:Q4_K_M"
HOST="127.0.0.1"
PORT="8081"
CTX_SIZE="49152"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
FLASH_ATTN="auto"
N_GPU_LAYERS="999"
PARALLEL="1"
JINJA="1"

# The one thing this changes about config/agent.env: a text-only flow never uses the
# projector, and 1.02 GB of wired memory is context on a machine with no desk to lose.
NO_MMPROJ="1"

# 0005's settled pair for thinking off, served rather than sent, and the template override
# Claude Code needs on every request. Both are config/agent.env's, for its reasons.
CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
TEMP="0.7"
TOP_P="0.80"
TOP_K="20"
PRESENCE_PENALTY="1.5"
CHAT_TEMPLATE_FILE="config/templates/qwen3.8-system-anywhere.jinja"

# The endpoint's own counters, off by default and the only per-run token column.
METRICS="1"
