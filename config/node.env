# The dedicated node's serving config (0056): config/agent.env with the multimodal
# projector off. The node has 36 GB against the laptop's 32 and no desk to protect.
#
# Screened one lever at a time on the node at 49,152 filled, 2026-09-14, and the projector is
# the only one that earns a setting here. CACHE_RAM moves peak wired by nothing at 0 or at
# 2048 MiB, since the host cache fills lazily; UBATCH_SIZE 256 costs 3 s of a 127 s fill for
# 0.07 GB and 512 is llama.cpp's own default; KV q4_0 saves 0.74 GB this machine is not short
# of; MLOCK moves no peak and takes free memory to 0.08 GB. None of them is set. The rows are
# docs/data/2026-09-14-m5max-36gb-screen.jsonl and the table is in docs/TECH.md.
#
# The context stays 49,152, which is capacity rather than tuning (0008). The ladder reaches
# 163,840 here with 5.81 GB of the raised cap still free — that is the machine file's ceiling
# — but nothing measured says a session needs more than the 45,056-token window this leaves,
# and both halves of the clock decay with the depth a session actually reaches.
#
# The draft head is admissible at this context on this node, where the laptop's allocator
# refuses it, and reads 1.67-1.88x on decode for 1.20 GB of wired memory. It is not set here:
# the laptop's own adoption of it rests on what it does to a whole chain, which is unmeasured
# on this machine.
#
# HOST stays loopback like every committed config. The serving LaunchDaemon sets
# HOST=0.0.0.0 in its environment, per 0053.
MODEL_HF="bartowski/Qwen3.8-27B-GGUF:Q4_K_M"
HOST="127.0.0.1"
PORT="8081"
CTX_SIZE="49152"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
FLASH_ATTN="auto"
N_GPU_LAYERS="999"
PARALLEL="1"
JINJA="1"

# The one thing this changes about config/agent.env: a text-only flow never uses the
# projector, and 1.02 GB of wired memory is context on a machine with no desk to lose.
NO_MMPROJ="1"

# 0005's settled pair for thinking off, served rather than sent, and the template override
# Claude Code needs on every request. Both are config/agent.env's, for its reasons.
CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
TEMP="0.7"
TOP_P="0.80"
TOP_K="20"
PRESENCE_PENALTY="1.5"
CHAT_TEMPLATE_FILE="config/templates/qwen3.8-system-anywhere.jinja"

# The endpoint's own counters, off by default and the only per-run token column.
METRICS="1"
