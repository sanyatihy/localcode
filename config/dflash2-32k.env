# Candidate B at the grind profile's context: config/tuned.env unchanged, plus the drafter.
# The target model and quant are deliberately the ones this project already serves — the
# lever being measured is the drafter, and swapping the target underneath it would measure
# two things at once.
#
# The drafter is 1.1 GB of weights plus its own KV, against the 0.54 GB of headroom 0014
# left at 32k. Whether that fits is what the screen decides.
#
# The mechanism exists only in llama.cpp PR #27342, so the binary is not the one on PATH:
# the Homebrew build stays where it is and this names a scratch build of the PR head,
# commit 5ecbe1ac17ec0484c5b44af0bd580cdc9c428ed4 of github.com/z-lab/llama.cpp-fork.
SERVER_BIN="$HOME/.local/src/llama.cpp-dflash2/build/bin/llama-server"
MODEL_HF="bartowski/Qwen3.8-27B-GGUF:Q4_K_M"
HOST="127.0.0.1"
PORT="8081"
CTX_SIZE="32768"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
FLASH_ATTN="auto"
N_GPU_LAYERS="999"
PARALLEL="1"
JINJA="1"

# 7 is the draft depth the model card publishes its acceptance figures at.
SPEC_DRAFT_HF="z-lab/Qwen3.8-27B-DFlash2-GGUF:Q4_K_M"
SPEC_TYPE="draft-dflash"
SPEC_DRAFT_N_MAX="7"
