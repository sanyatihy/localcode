# config/mtp-49k.env with the host prompt cache off. 0017 refused the MTP head at this
# context on kIOGPUCommandBufferCallbackErrorOutOfMemory, and that screen ran with
# llama-server's default 8192 MiB of prompt cache competing for the same unified memory
# because no config here named the flag. This is the one variable moved.
SERVER_BIN="$HOME/.local/src/llama.cpp-dflash2/build/bin/llama-server"
MODEL_HF="bartowski/Qwen3.8-27B-GGUF:Q4_K_M"
HOST="127.0.0.1"
PORT="8081"
CTX_SIZE="49152"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
FLASH_ATTN="auto"
N_GPU_LAYERS="999"
PARALLEL="1"
JINJA="1"
SPEC_TYPE="draft-mtp"
SPEC_DRAFT_N_MAX="3"
CACHE_RAM="0"

CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
TEMP="0.7"
TOP_P="0.80"
TOP_K="20"
PRESENCE_PENALTY="1.5"
CHAT_TEMPLATE_FILE="config/templates/qwen3.8-system-anywhere.jinja"
