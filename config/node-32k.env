# The dedicated node's serving config (0056): config/driver-mtp-32k-stock.env with the
# multimodal projector off, which is 1.02 GB of the node's 24 GB back. Every other server
# lever here is that file's and unsettled on this machine until 0056's screen runs —
# CACHE_RAM, UBATCH_SIZE, the KV type, the draft head and MLOCK — and this file records
# what the screen settles.
#
# HOST stays loopback like every committed config. The serving LaunchDaemon sets
# HOST=0.0.0.0 in its environment, per 0053.
MODEL_HF="bartowski/Qwen3.8-27B-GGUF:Q4_K_M"
HOST="127.0.0.1"
PORT="8081"
CTX_SIZE="32768"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
FLASH_ATTN="auto"
N_GPU_LAYERS="999"
PARALLEL="1"
JINJA="1"

# The text-only flow does not use the projector; 24 GB is why it is off here and not there.
NO_MMPROJ="1"

# The target's own MTP head, admissible at 32,768 and refused at 49,152 (0017, 0051).
SPEC_TYPE="draft-mtp"
SPEC_DRAFT_N_MAX="3"

# 0005's settled pair for thinking off, served rather than sent, and the template override
# Claude Code needs. Both are config/driver-mtp-32k-stock.env's, for its reasons.
CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
TEMP="0.7"
TOP_P="0.80"
TOP_K="20"
PRESENCE_PENALTY="1.5"
CHAT_TEMPLATE_FILE="config/templates/qwen3.8-system-anywhere.jinja"

# The endpoint's own counters, off by default and the only per-run token column.
METRICS="1"
