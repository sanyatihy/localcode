# The serving config 0005 settled, for both profiles. Sampling is not set here — it is a
# per-request property and the recommended values differ by thinking mode, so they live in
# `cmd/eval -sampling-profile` and in docs/TECH.md rather than in a server flag.
#
# Context is 32k: 0003 measured ingest as the binding cost (5.4 min cold at 32k, 13.1 at
# 64k) and 0014 put the attended ceiling at 57,344, so 32k sits inside both. KV at q8_0
# matched f16 on every ladder cell while costing less.
MODEL_HF="bartowski/Qwen3.8-27B-GGUF:Q4_K_M"
HOST="127.0.0.1"
PORT="8081"
CTX_SIZE="32768"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
FLASH_ATTN="auto"
N_GPU_LAYERS="999"
PARALLEL="1"
JINJA="1"
