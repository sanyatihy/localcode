# Candidate B at the editor profile's context: config/agent.env unchanged, plus the drafter.
# Same reasoning as config/dflash2-32k.env, the same drafter and the same scratch build; what
# differs is the context and the serving defaults the editor flow needs, which 0008 settled.
SERVER_BIN="$HOME/.local/src/llama.cpp-dflash2/build/bin/llama-server"
MODEL_HF="bartowski/Qwen3.8-27B-GGUF:Q4_K_M"
HOST="127.0.0.1"
PORT="8081"
CTX_SIZE="49152"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
FLASH_ATTN="auto"
N_GPU_LAYERS="999"
PARALLEL="1"
JINJA="1"

# 7 is the draft depth the model card publishes its acceptance figures at.
SPEC_DRAFT_HF="z-lab/Qwen3.8-27B-DFlash2-GGUF:Q4_K_M"
SPEC_TYPE="draft-dflash"
SPEC_DRAFT_N_MAX="7"

# The half of the winning config that is per-request everywhere else, served as defaults
# because the editor sends its own body. Copied from config/agent.env, where the reasons are.
CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
TEMP="0.7"
TOP_P="0.80"
TOP_K="20"
PRESENCE_PENALTY="1.5"
CHAT_TEMPLATE_FILE="config/templates/qwen3.8-system-anywhere.jinja"
