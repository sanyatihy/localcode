# The serving config for the harness comparison (0010): config/agent.env, at the one
# context all four candidates can share.
#
# 65,536 is not a choice about capacity. Hermes refuses any context below 64,000, checked
# before it opens a connection, so the smallest window that serves all four is the next
# rung above its floor. 0014 measured 65,536 as leaving the desktop unusable for the whole
# run — the compositor stalls rather than saturates — so this config is **unattended only**,
# and `cmd/tier2 -profile attended` refuses to record rows against it.
#
# Everything else is 0008's editor config, because the comparison must not measure two
# things at once: the harnesses build their own request bodies and send neither sampling
# nor the thinking toggle, so both are served as defaults here or the config that runs is
# not the one 0005 settled.
MODEL_HF="bartowski/Qwen3.8-27B-GGUF:Q4_K_M"
HOST="127.0.0.1"
PORT="8081"
CTX_SIZE="65536"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
FLASH_ATTN="auto"
N_GPU_LAYERS="999"
PARALLEL="1"
JINJA="1"

# The comparison's per-run token counts come from the server, because each harness builds
# its own requests and none of them reports in the same units.
METRICS="1"

# 0005's settled pair for thinking off, served rather than sent — see above.
CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
TEMP="0.7"
TOP_P="0.80"
TOP_K="20"
PRESENCE_PENALTY="1.5"

# Claude Code sends a `role: "system"` message after the user turn on every request, which
# the model's own template raises on. The override differs from the shipped template in one
# line: a non-leading system message renders as its own ChatML system block.
CHAT_TEMPLATE_FILE="config/templates/qwen3.8-system-anywhere.jinja"
