# Baseline serving config for localcode. Every flag llama-server is launched with
# lives here; scripts/serve.sh adds nothing of its own.
#
# Later features add a sibling file per variant rather than editing this one:
#   scripts/serve.sh config/ctx16k-f16.env
#
# Model is resolved from llama.cpp's HF cache. -hf cannot pin a revision, so the
# snapshot observed on 2026-08-17 is recorded here and drift stays detectable:
#   f0eec4a4bb4975114a030d048952d83c0a53c034
MODEL_HF="bartowski/Qwen3.8-27B-GGUF:Q4_K_M"

HOST="127.0.0.1"          # loopback only — the vision rules out serving beyond this machine
PORT="8080"

CTX_SIZE="32768"          # 0003 finds the ceiling; this is the anchor it starts from
CACHE_TYPE_K="q8_0"       # f16 would double KV and not fit at this context
CACHE_TYPE_V="q8_0"
FLASH_ATTN="auto"
N_GPU_LAYERS="999"        # all layers on GPU
PARALLEL="1"              # one slot: concurrent requests would contend for the same memory
JINJA="1"                 # model's own chat template — carries thinking blocks and tool-call format
