# config/mtp-32k.env served by the binary on PATH instead of the fork checkout. 0017 named
# that fork because stock llama.cpp was reported to drop the MTP tensors; stock 10809 offers
# `draft-mtp` under `--spec-type`, and 0051 measures whether it loads them for this GGUF.
# Everything else is config/mtp-32k.env unchanged, so the pair differs by the binary alone.
MODEL_HF="bartowski/Qwen3.8-27B-GGUF:Q4_K_M"
HOST="127.0.0.1"
PORT="8081"
CTX_SIZE="32768"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
FLASH_ATTN="auto"
N_GPU_LAYERS="999"
PARALLEL="1"
JINJA="1"
SPEC_TYPE="draft-mtp"
SPEC_DRAFT_N_MAX="3"
