# Candidate B on the dedicated node: config/node.env unchanged, plus the DFlash2 drafter.
# The baseline it is paired against is that file, so the projector stays off here too and
# the drafter is the only thing this config moves. What it cannot hold fixed is the build:
# `--spec-type draft-dflash` exists only in llama.cpp PR #27342, so this serves the scratch
# build runtimes/dflash2/build.sh produces, against the baseline's Homebrew b10809.
SERVER_BIN="$HOME/.local/src/llama.cpp-dflash2/build/bin/llama-server"
MODEL_HF="bartowski/Qwen3.8-27B-GGUF:Q4_K_M"
HOST="127.0.0.1"
PORT="8081"
CTX_SIZE="49152"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
FLASH_ATTN="auto"
N_GPU_LAYERS="999"
PARALLEL="1"
JINJA="1"
NO_MMPROJ="1"
METRICS="1"

# The drafter config/dflash2-49k.env names, by path rather than by tag. That repository's
# main moved from 57ab3265 to 2d9571f8 after 0017 measured it — the Q4_K_M file grew by 64
# bytes — and `-hfd z-lab/...:Q4_K_M` therefore asks this node for a 1.1 GB download its
# link delivers at tens of kilobytes a second. 57ab3265 is the revision 0017 measured and
# the one in this machine's cache, and naming the snapshot puts that revision in the row.
SPEC_DRAFT_MODEL="$HOME/.cache/huggingface/hub/models--z-lab--Qwen3.8-27B-DFlash2-GGUF/snapshots/57ab3265056d4024870b0621cfc2c127537020ed/Qwen3.8-27B-DFlash2-Q4_K_M.gguf"
# 7 is the draft depth the model card publishes its acceptance figures at.
SPEC_TYPE="draft-dflash"
SPEC_DRAFT_N_MAX="7"

# Served as defaults, copied from config/node.env where the reasons are.
CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
TEMP="0.7"
TOP_P="0.80"
TOP_K="20"
PRESENCE_PENALTY="1.5"
CHAT_TEMPLATE_FILE="config/templates/qwen3.8-system-anywhere.jinja"
