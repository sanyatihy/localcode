# config/driver-mtp-32k.env served by the binary on PATH. That file is frozen as the record
# of what 0025's chain was measured on, which is why this is a new file rather than an edit;
# it is the one to use now, since 0051 retired the fork build the older one names.
#
# Two things differ from config/agent.env and they are the same change. The MTP head is a
# measured 1.26-1.40x on decode, which is 90% of a chain's wall clock; 0017 screened it
# admissible at 32,768 and refused at 49,152, where the allocator fails on the first prefill
# batch. So the speedup costs the context, and the driver is the flow that can pay: the
# preamble a `localcode` session starts with is 4,395 tokens, against the 36,309 an editor
# session's first request measured. 49,152 was chosen for that request and never for this one.
#
# What the smaller context costs is sessions. The declared window is CTX_SIZE minus the
# 4,096 output reservation, so 28,672 here against 45,056 there, and a session's ceiling
# falls with it: 10,240 against 22,528, which is 5,845 tokens of room above the preamble
# against 18,133. Three times the handoffs, each one a re-ingested preamble and a summary
# generated at decode speed, against a decode ratio near 1.3. Which way that lands the
# arithmetic could not settle, so a chain was run both ways: twenty independent bugs finished
# in 661 s here against 824 s at 49,152, having spent the second session and 2,885 more
# ingested tokens. docs/TECH.md carries the table and what one run a side cannot answer.
#
# Everything else is config/agent.env unchanged, because the driver runs Claude Code and
# therefore needs every default that flow needs served rather than sent.
MODEL_HF="bartowski/Qwen3.8-27B-GGUF:Q4_K_M"
HOST="127.0.0.1"
PORT="8081"
CTX_SIZE="32768"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
FLASH_ATTN="auto"
N_GPU_LAYERS="999"
PARALLEL="1"
JINJA="1"

# The MTP head the target GGUF already carries, drafted against the same weights. No
# SERVER_BIN: 0051 measured stock 10809 creating the same draft context as the fork build,
# at the same acceptance and the same greedy hash, so the binary on PATH is the one to use.
SPEC_TYPE="draft-mtp"
SPEC_DRAFT_N_MAX="3"

# The prefill batch is unset, so llama.cpp's 2048 logical and 512 physical serve. 0024 swept
# this profile and kept the default; the MTP draft context is a second allocation on top of
# it, which is a reason to move it down rather than up.

# 0005's settled pair for thinking off, served rather than sent: Claude Code sends its own
# request body and neither of them.
CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
TEMP="0.7"
TOP_P="0.80"
TOP_K="20"
PRESENCE_PENALTY="1.5"

# Claude Code sends a `role: "system"` message after the user turn on every request. The
# model's own template raises on it, which llama.cpp returns as a 500 and the session does
# not recover from. The override renders it as its own ChatML system block instead.
CHAT_TEMPLATE_FILE="config/templates/qwen3.8-system-anywhere.jinja"

# The endpoint's own counters, off by default. A chain's ingested and generated tokens are
# read from them either side of the run, so without this the comparison has no token column.
METRICS="1"
