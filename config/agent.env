# The serving config for the editor flow (0008): config/tuned.env, plus the half of
# the winning config that is per-request everywhere else.
#
# The scorer sends sampling and the thinking toggle on every request. Claude Code
# sends its own body and neither of them, so through /v1/messages the only place the
# settled config can live is the server's defaults. Served without these, this model
# thinks at `xhigh` by default — which 0005 measured as no better and four times the
# wall clock, and which three tier-1 tasks never terminated at.
#
# The context is 57,344 rather than the scorer's 32,768, and that is capacity rather than
# tuning: an editor session's first request measured 36,297 tokens — the tool set, the
# project's own instructions and the editor's context — which does not fit 32,768 before
# anybody types. 57,344 is 0014's attended ceiling; 65,536 made the desktop unusable. It
# is not free: prompt throughput decays with depth, so this trades roughly a tenth of the
# ingest rate for a flow that can start at all.
MODEL_HF="bartowski/Qwen3.8-27B-GGUF:Q4_K_M"
HOST="127.0.0.1"
PORT="8081"
CTX_SIZE="57344"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
FLASH_ATTN="auto"
N_GPU_LAYERS="999"
PARALLEL="1"
JINJA="1"

# 0005's settled pair for thinking off. `enable_thinking` is the model's own template
# kwarg — the same mechanism config/profiles/qwen3.8.json names, so this serves what
# the scorer measured rather than something adjacent to it.
CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
TEMP="0.7"
TOP_P="0.80"
TOP_K="20"
PRESENCE_PENALTY="1.5"

# Claude Code sends a `role: "system"` message after the user turn — the
# `mid-conversation-system-2026-04-07` capability, sent on every request whether 21
# tools are defined or none. The model's own template raises on it, which llama.cpp
# returns as a 500 and Claude Code retries ten times and gives up. The override differs
# from the shipped template in one line: a non-leading system message renders as its own
# ChatML system block instead of raising.
CHAT_TEMPLATE_FILE="config/templates/qwen3.8-system-anywhere.jinja"
