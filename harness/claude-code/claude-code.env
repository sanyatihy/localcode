# Claude Code's environment for the local endpoint — its equivalent of the provider
# block each other harness needs. Source it into the shell that launches the agent:
#
#   set -a; . harness/claude-code/claude-code.env; set +a; claude
#
# Every variable here is documented by Claude Code itself — code.claude.com/docs/en
# {env-vars, model-config, llm-gateway-connect, llm-gateway-protocol, costs}, read
# against 2.1.233. `DISABLE_NON_ESSENTIAL_MODEL_CALLS` is the variable the write-ups
# name for this job and it appears in none of them; it is not set here.

# --- routing ------------------------------------------------------------------
# One base URL carries every model call — the main completion, the Haiku-class
# background calls, and every subagent — so no prompt can reach a hosted model, and
# all of them instead queue for llama-server's single slot. Host and port match
# config/agent.env, which is the config this flow needs served.
ANTHROPIC_BASE_URL="http://127.0.0.1:8081"

# A credential, not a secret: llama-server authenticates nothing, and the value is
# set only so a saved claude.ai login stops being the active credential. With the
# base URL alone the login stays active, and its OAuth refresh with it.
ANTHROPIC_AUTH_TOKEN="local"

# --- every alias names the one model that is served ---------------------------
# The server ignores the requested name, but Claude Code does not: the model ID is
# what it reads capabilities and a context window off. Naming what /props reports
# keeps a transcript and a docs/data row talking about the same thing.
#
# ANTHROPIC_DEFAULT_HAIKU_MODEL is the background-call variable: it is documented as
# the model for "background functionality" — the summaries `claude --resume` reads
# and status commands like /usage. `ANTHROPIC_SMALL_FAST_MODEL` is its deprecated
# name and is what most write-ups still set.
ANTHROPIC_MODEL="Qwen3.8-27B-Q4_K_M.gguf"
ANTHROPIC_DEFAULT_HAIKU_MODEL="Qwen3.8-27B-Q4_K_M.gguf"
ANTHROPIC_DEFAULT_SONNET_MODEL="Qwen3.8-27B-Q4_K_M.gguf"
ANTHROPIC_DEFAULT_OPUS_MODEL="Qwen3.8-27B-Q4_K_M.gguf"

# --- calls that are not the task ----------------------------------------------
# The session title comes from a separate small/fast-model request. Skipping that
# request is documented for `claude -p` and Agent SDK sessions; interactively the
# variable is documented only to stop the title updates themselves.
CLAUDE_CODE_DISABLE_TERMINAL_TITLE="1"

# Explore and Plan run as subagents. Concurrency has nowhere to go here, so the
# search tools serve the same purpose without a second request in the queue.
CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS="1"

# A scheduled task fires on its interval even while the session is idle, and sends
# the whole context when it does.
CLAUDE_CODE_DISABLE_CRON="1"

# Auto-update, telemetry, error reporting, /feedback, release notes and the fast-mode
# availability check. It also stops feature-flag fetching, which costs auto mode as a
# starting permission mode, Remote Control and cross-session messaging.
#
# On its own it would not make the flow offline: the fast-mode check and WebFetch's
# domain-safety check address api.anthropic.com rather than following ANTHROPIC_BASE_URL,
# and the latter is a setting, `skipWebFetchPreflight`, not a variable. Measured since:
# with this set a real task contacts no host at all, and completes with the network denied
# in the kernel. Unset, the same task makes 9 connections to api.anthropic.com.
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"

# --- the context ceiling, declared rather than discovered ---------------------
# Claude Code does not recognise this model id, so left alone it asks for 32,000
# output tokens against a 32,768 context and compacts at whatever window it assumes.
# The first sign of the real ceiling is then llama-server's own 400 —
# `exceed_context_size_error`, naming both numbers — which it surfaces verbatim and
# does not recover from. Not silent, but the session ends there.
#
# Declared, it counts the conversation through /v1/messages/count_tokens — the served
# tokeniser, so the count is the truth — and refuses before sending, which on this
# machine saves minutes of ingest that could not have succeeded.
#
# The documented alternative for an unrecognised id,
# CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1, is wrong here: it defers
# compaction until the API rejects the conversation with Anthropic's too-long error,
# and llama-server's wording is its own. The same mismatch already cost the retry that
# should have handled the mid-conversation system message.
#
# The two numbers are one: the prompt and the reply share the served context, so the
# declared window is CTX_SIZE minus the output reservation. 4,096 is what the other
# harnesses declare for this model. A window near the fixed preamble is unusable —
# at 8,000 a two-turn session with one tool call already exceeds it.
#
# 45,056 is CTX_SIZE minus the reservation, against config/agent.env's 49,152. The
# window catches an overflow between turns and not the preamble a session starts
# with: an editor session whose first request was 36,297 tokens sent it and took
# llama-server's 400, with the window declared at 28,672.
CLAUDE_CODE_MAX_OUTPUT_TOKENS="4096"
CLAUDE_CODE_MAX_CONTEXT_TOKENS="45056"
