# MLX side of 0006. Matched to config/tuned.env by footprint rather than by name: MLX 4bit
# is 16.1 GB of weights against llama.cpp Q4_K_M's 17 GB, which is the closest pair
# available. The 8bit build is 29.5 GB and sits past the ~22.2 GB admissible wired budget
# 0014 measured, so it is not a candidate on this machine.
#
# Context is not set here. mlx_lm sizes the KV cache per request rather than reserving one
# at load, so "the context it serves" is not the same kind of number as llama.cpp's --ctx-size
# and must not be recorded as if it were. 0006 measures depth by sending deep prompts.
MODEL_HF="mlx-community/Qwen3.8-27B-4bit"
HOST="127.0.0.1"
PORT="8082"
MAX_TOKENS="8192"

# The KV cache must be bounded or it takes the machine. mlx_lm wires its caches and the
# LRU keeps them across requests: unbounded, one 16k prompt drove free memory to zero and
# every later request stalled — no swap growth at all, because wired pages cannot be paged
# out. 0014 measured the admissible wired budget at ~22.2 GB and MLX loads at 15.7 GB
# wired, so 4 GB of cache leaves headroom rather than spending all of it.
PROMPT_CACHE_BYTES="4000000000"
# 16, not 2. The suite interleaves 14 distinct prompts before repeating any, so a
# two-slot cache is evicted before every repeat — which measured as "MLX has no prompt
# reuse" when an identical back-to-back request actually returns in 0.5 s against 19.6 s
# cold. The count was the binding limit, never the byte bound: the five depth caches come
# to roughly 2.3 GB at the 64 KB/token this model's hybrid attention costs.
PROMPT_CACHE_SIZE="16"

# 2048 is the server default. Reported to reach ~1.5x at 4096-8192, untested here and
# deliberately left alone: it moves prefill throughput, which is the thing being compared.
PREFILL_STEP_SIZE="2048"
