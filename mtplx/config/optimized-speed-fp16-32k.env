# Candidate A at the grind profile's context. The FP16 build and not its parent: this is an
# M2 Max, and MTPLX routes M1 and M2 Macs to the FP16 siblings — same quantized weights,
# fp16 rather than bf16 for what is left, because those chips do not run bf16 well. `mtplx
# doctor` resolves this exact id as the default for this machine.
#
# 20.68 GB of weights against 0014's 22.29 GB desktop-fail point, and the vendor's own
# preflight estimates a 25.0 GiB peak. Whether that is admissible here is what the screen
# measures; it is not assumed either way.
MODEL_HF="Youssofal/Qwen3.8-27B-MTPLX-Optimized-Speed-FP16"
HOST="127.0.0.1"
PORT="8083"

# Turbo is what MTPLX resolves for this model, and its compiled-verify fence tops out at
# 32,768 — so this profile and the grind context are the same cell by construction.
PROFILE="turbo"
CONTEXT_WINDOW="32768"
MAX_TOKENS="8192"

# The mechanism under test. `ar` serves the same weights with speculation off, which is the
# paired baseline the ratio is measured against rather than a second config to argue about.
GENERATION_MODE="mtp"
