# optimized-speed-fp16-32k.env with the KV cache quantised, which is the lever
# config/tuned.env already pulls for llama.cpp. Committed because it produced a measurement,
# not because it works: q4 saved 0.17 GB of a 1.1 GB overshoot, since this candidate's
# problem is 20.68 GB of weights rather than its cache.
MODEL_HF="Youssofal/Qwen3.8-27B-MTPLX-Optimized-Speed-FP16"
HOST="127.0.0.1"
PORT="8083"
PROFILE="turbo"
CONTEXT_WINDOW="32768"
MAX_TOKENS="8192"
GENERATION_MODE="mtp"
PAGED_KV_QUANTIZATION="q4"
