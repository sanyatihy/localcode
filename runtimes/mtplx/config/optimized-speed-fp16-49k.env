# Candidate A at the editor profile's context. Same build and the same reasoning as
# mtplx/config/optimized-speed-fp16-32k.env; what differs is the context and, forced by it,
# the profile: turbo's compiled-verify fence stops at 32,768, so 49,152 is served on
# sustained. The two rows are therefore not one variable apart, and the screen says so.
MODEL_HF="Youssofal/Qwen3.8-27B-MTPLX-Optimized-Speed-FP16"
HOST="127.0.0.1"
PORT="8083"
PROFILE="sustained"
CONTEXT_WINDOW="49152"
MAX_TOKENS="8192"
GENERATION_MODE="mtp"
